# Copy to .env and edit. Placeholders only - never commit real values.
DEMO_MODE=1                      # 1 = embedded SQLite demo (default), 0 = real CRM
PORT=8090
HOST=127.0.0.1
DATA_DIR=./data
SESSION_SECRET=              # set a long random string; empty = random secret per start
COOKIE_SECURE=0                  # 1 when served over HTTPS
# Only needed when DEMO_MODE=0
CRM_URL=https://crm.example.com
CRM_TOKEN=token your_api_key:your_api_secret
# Optional
KIOSK_KEY=
KIOSK_USER=admin@example.com
SOURCE_WEBHOOK_URL=https://hooks.example.com/lead-status
SOURCE_WEBHOOK_TOKEN=
